(function() {
    if (window._mvuFinalStableV08152) return;
    await waitGlobalInitialized('Mvu');
    console.log('✅ MVU 性愛與生理系統 已啓用');

    var _ = window._;
    var get = function(o, p) { return _.get(o, p); };
    var set = function(o, p, v) { return _.set(o, p, v); };

    var isProcessing = false;
    var lastSnapshot = null;
    var fixCount = 0;
    var delCount = 0;
    var lastLogHash = '';

    var DEBUG_MODE = false;

    function debugLog() {
        if (DEBUG_MODE) console.log('[🔍]', ...arguments);
    }
    function keyLog() { console.log('[📌]', ...arguments); }
    function errorLog() { console.error('[❌]', ...arguments); }

    // ========== 工具函數 ==========
    function int(v) { return Number.isFinite(v) ? Math.round(v) : v; }
    function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
    function v(val, def) { return Number.isFinite(val) ? val : (Number.isFinite(def) ? def : 0); }

    function parseTime(str) {
        var m = /^(\d{1,2}):(\d{2})$/.exec(str);
        return m ? parseInt(m[1]) * 60 + parseInt(m[2]) : null;
    }

    function getCurrentTime(vars) {
        var day = get(vars, '系統.經過天數'),
            time = get(vars, '系統.當前時間');
        if (!Number.isFinite(day) || typeof time != 'string') return null;
        var m = parseTime(time);
        return m === null ? null : { day: day, hour: Math.floor(m / 60), minute: m % 60, total: day * 1440 + m };
    }

    // ========== 性愛系統核心 ==========
    var AFFECTION_SYSTEM = {
        STAGES: {
            1: { name: '陌生', range: [1,1], 模糊地帶: false },
            2: { name: '朋友-穩定期', range: [2,2], 模糊地帶: false },
            3: { name: '朋友-親密臨界區', range: [3,3], 模糊地帶: true },
            4: { name: '摯友-深度期', range: [4,5], 模糊地帶: false },
            6: { name: '摯友-戀人臨界區', range: [6,7], 模糊地帶: true },
            8: { name: '戀人-新晉期', range: [8,8], 模糊地帶: false },
            9: { name: '戀人-穩定臨界區', range: [9,9], 模糊地帶: true },
            10: { name: '摯愛', range: [10,999], 模糊地帶: false }
        },
        getStage: function(level) {
            var l = Number(level);
            if (isNaN(l) || l < 1) return this.STAGES[1];
            for (var key in this.STAGES) {
                var stage = this.STAGES[key];
                if (l >= stage.range[0] && l <= stage.range[1]) return stage;
            }
            return this.STAGES[10];
        },
        getStageName: function(level) { return this.getStage(level).name; },
        isInGrayZone: function(level) { return this.getStage(level).模糊地帶; }
    };

    var SEXUAL_CONFIG = {
        CORRUPTION_STAGES: {
            0: { name: '初次被迫', minCount: 1, maxCount: 1 },
            1: { name: '重複暴露', minCount: 2, maxCount: 3 },
            2: { name: '生理轉折點', minCount: 4, maxCount: 4 },
            3: { name: '矛盾加劇', minCount: 5, maxCount: 7 },
            4: { name: '開始沉淪', minCount: 8, maxCount: 999 }
        }
    };

    function ensureSexResultArray(vars) {
        var raw = get(vars, '系統.性愛結果');
        if (raw === undefined || raw === null) {
            set(vars, '系統.性愛結果', []);
            return [];
        }
        if (Array.isArray(raw)) return raw;
        if (typeof raw === 'object' && raw.角色) {
            var migrated = [raw];
            set(vars, '系統.性愛結果', migrated);
            keyLog('🔄 性愛結果格式轉換：物件 → 陣列');
            return migrated;
        }
        set(vars, '系統.性愛結果', []);
        return [];
    }

    function getAffectionStageForSex(level) {
        var stage = AFFECTION_SYSTEM.getStage(level);
        var map = {
            '陌生': '初階期',
            '朋友-穩定期': '初階期',
            '朋友-親密臨界區': '初階期',
            '摯友-深度期': '中階期',
            '摯友-戀人臨界區': '中階期',
            '戀人-新晉期': '高階期',
            '戀人-穩定臨界區': '高階期',
            '摯愛': '頂階頂'
        };
        return map[stage.name] || '初階期';
    }

    function calculateVoluntary(affectionLevel, interactionType, statusEffects, isSudden, hasTrauma, specialStatus) {
        var base = 50 + (affectionLevel * 5);
        if (interactionType === '情感推進') base += 10;
        else if (interactionType === '強制欺騙') base -= 40;
        
        if (affectionLevel >= 10) base += 20;
        else if (affectionLevel >= 7) base += 10;
        else if (affectionLevel >= 4) base += 5;
        else if (affectionLevel === 1) base -= 10;
        
        if (statusEffects && statusEffects.indexOf('恐懼') !== -1) base -= 15;
        if (statusEffects && statusEffects.indexOf('壓力') !== -1) base -= 10;
        if (statusEffects && statusEffects.indexOf('興致') !== -1) base += 15;
        if (isSudden) base -= 20;
        if (hasTrauma) base -= 20;
        if (specialStatus === '自責傾向') base -= 10;
        else if (specialStatus === '共犯') base += 20;
        
        return Math.max(0, Math.min(100, base));
    }

    function getResultGrade(voluntary) {
        if (voluntary >= 90) return { grade: '高度自願-主動', description: '主動推進 + 愉悅表現' };
        if (voluntary >= 80) return { grade: '高度自願-積極', description: '積極配合 + 正向反饋' };
        if (voluntary >= 70) return { grade: '高度自願-害羞', description: '害羞但允許 + 輕微緊張' };
        if (voluntary >= 60) return { grade: '矛盾-逐漸接受', description: '初始抗拒→逐漸接受' };
        if (voluntary >= 50) return { grade: '矛盾-明顯猶豫', description: '明顯猶豫 + 內心掙扎' };
        if (voluntary >= 40) return { grade: '矛盾-持續輕拒', description: '持續輕拒 + 不情願' };
        if (voluntary >= 30) return { grade: '非自願-忍耐', description: '被動承受 + 事後懊悔' };
        if (voluntary >= 20) return { grade: '非自願-無力反抗', description: '持續抗拒但漸弱' };
        if (voluntary >= 10) return { grade: '非自願-被迫接受', description: '恐懼服從 + 無奈' };
        return { grade: '非自願-激烈反抗', description: '激烈抗拒 + 創傷反應' };
    }

    function getCorruptionStage(forcedCount, affectionLevel) {
        var adj = forcedCount;
        if (affectionLevel >= 16) adj += 3;
        else if (affectionLevel >= 13) adj += 2;
        else if (affectionLevel >= 10) adj += 1;
        
        for (var stage in SEXUAL_CONFIG.CORRUPTION_STAGES) {
            var cfg = SEXUAL_CONFIG.CORRUPTION_STAGES[stage];
            if (adj >= cfg.minCount && adj <= cfg.maxCount) {
                return { stage: parseInt(stage), name: cfg.name };
            }
        }
        return { stage: 4, name: '開始沉淪' };
    }

    function calculateAffectionChange(voluntary, affectionLevel, interactionType, specialStatus, isSuccess) {
        var expChange = 0, levelChange = 0, newStatus = specialStatus, trauma = '';
        
        if (!isSuccess) {
            if (voluntary < 30) {
                return { expChange: -999, levelChange: -1, newSpecialStatus: specialStatus, traumaMark: '嚴重創傷' };
            }
            return { expChange: 0, levelChange: 0, newSpecialStatus: specialStatus, traumaMark: '' };
        }
        
        var stage = getAffectionStageForSex(affectionLevel);
        var isForced = (interactionType === '強制欺騙' && voluntary < 40);
        
        if (voluntary >= 70) {
            expChange = Math.min(100, 30 + Math.floor(voluntary / 2));
        } else if (voluntary >= 40) {
            if (voluntary > 50) expChange = Math.min(50, Math.floor((voluntary - 50) * 5));
            else if (voluntary < 50) expChange = Math.max(-20, Math.floor((voluntary - 50) * 4));
        }
        
        if (voluntary < 40 && isForced) {
            expChange = 0;
            if (stage === '初階期') {
                levelChange = -1;
                trauma = '關係動搖';
            } else if (stage === '中階期') {
                levelChange = 0;
                trauma = '關係動搖';
            } else if (stage === '高階期') {
                expChange = -999;
                newStatus = '自責傾向';
                trauma = '自責傾向觸發';
            } else if (stage === '頂階初') {
                expChange = 40;
                newStatus = '扭曲依賴';
                trauma = '扭曲依賴觸發';
            } else if (stage === '頂階中') {
                expChange = 100;
                if (Math.random() < 0.1) levelChange = 1;
                newStatus = '徹底沉淪';
                trauma = '徹底沉淪觸發';
            } else if (stage === '頂階頂') {
                expChange = 150;
                levelChange = 1;
                newStatus = '共犯';
                trauma = '共犯覺醒觸發';
            }
        }
        
        return {
            expChange: expChange,
            levelChange: levelChange,
            newSpecialStatus: newStatus,
            traumaMark: trauma
        };
    }

    // ========== 懷孕系統 ==========
    function calculatePregnancy(vars, characterName, isInternalEjaculation, contraceptive) {
        var base = '同伴.' + characterName;
        
        var gender = get(vars, base + '.基礎信息.性別');
        if (gender !== '女' && gender !== 'female' && gender !== '女性') {
            return false;
        }
        
        var pregnancyState = get(vars, base + '.生理狀態.懷孕狀態');
        if (pregnancyState && pregnancyState !== '未懷孕' && pregnancyState !== '流產') {
            return false;
        }
        
        if (contraceptive === '保險套' || contraceptive === '避孕藥') {
            set(vars, base + '.生理狀態.懷孕天數', 0);
            return false;
        }
        
        var sexResults = ensureSexResultArray(vars);
        var inseminator = '未知';
        for (var i = 0; i < sexResults.length; i++) {
            if (sexResults[i].角色 === characterName && sexResults[i].授精者) {
                inseminator = sexResults[i].授精者;
                break;
            }
        }
        if (inseminator === '未知') {
            inseminator = get(vars, '基礎信息.名字') || '未知';
        }
        
        var isPullOut = (contraceptive === '體外射精');
        var cycleDay = get(vars, base + '.生理狀態.月經週期') || 14;
        var cyclePhase = '安全期';
        if (cycleDay >= 1 && cycleDay <= 5) cyclePhase = '月經期';
        else if (cycleDay >= 10 && cycleDay <= 16) cyclePhase = '危險期';
        
        var baseChance = 0;
        if (cyclePhase === '危險期') {
            baseChance = isInternalEjaculation ? 25 : 8;
        } else if (cyclePhase === '安全期') {
            baseChance = isInternalEjaculation ? 2 : 0.5;
        } else {
            baseChance = isInternalEjaculation ? 0.3 : 0;
        }

        if (isPullOut && isInternalEjaculation === false) {
            baseChance = Math.floor(baseChance * 0.25);
        }
        
        if (contraceptive === '安全期') {
            baseChance = Math.min(baseChance, 2);
        }
        
        var talentBonus = 0;
        var talents = get(vars, base + '.天賦特性');
        if (_.isPlainObject(talents)) {
            for (var talentName in talents) {
                if (talentName.startsWith('$')) continue;
                var talent = talents[talentName];
                if (talent && talent.加值 && typeof talent.加值 === 'object') {
                    for (var key in talent.加值) {
                        if (key.indexOf('孕') !== -1) {
                            var bonusValue = talent.加值[key];
                            if (typeof bonusValue === 'number') talentBonus += Math.floor(bonusValue / 10);
                            break;
                        }
                    }
                }
            }
        }
        
        var finalChance = Math.min(99, Math.max(0, baseChance + talentBonus));
        var dice = Math.floor(Math.random() * 100) + 1;
        var isPregnant = dice <= finalChance;
        
        if (isPregnant) {
            var currentPregnancyState = get(vars, base + '.生理狀態.懷孕狀態');
            if (!currentPregnancyState || currentPregnancyState === '未懷孕' || currentPregnancyState === '流產') {
                set(vars, base + '.生理狀態.懷孕狀態', '懷孕初期');
            }
            
            var currentDay = get(vars, '系統.經過天數') || 0;
            set(vars, base + '.生理狀態.懷孕日', currentDay);
            set(vars, base + '.生理狀態.懷孕天數', 0);
            set(vars, base + '.生理狀態.授精者', inseminator);
            
            keyLog('🤰 ' + characterName + ' 懷孕了！');
        } else {
            set(vars, base + '.生理狀態.懷孕天數', 0);
        }
        return isPregnant;
    }

    // ========== 生育 ==========
    function generateNewborn(vars, motherName, motherPath) {
        var litter = 1;
        if (Math.floor(Math.random() * 100) + 1 <= 10) {
            litter = 2;
            keyLog('👶👶 雙胞胎！');
        }
        
        var children = get(vars, '子嗣');
        if (!_.isPlainObject(children)) {
            children = {};
            set(vars, '子嗣', children);
        }
        
        var birthCount = get(vars, motherPath + '.生育次數') || 0;
        set(vars, motherPath + '.生育次數', birthCount + litter);
        
        for (var i = 0; i < litter; i++) {
            var gender = Math.random() < 0.5 ? '女' : '男';
            var existing = 0;
            for (var name in children) {
                if (name.startsWith('$')) continue;
                var data = children[name];
                if (data && data.母親 === motherName) existing++;
            }
            var childNumber = existing + i + 1;
            var childName = motherName + '的孩子' + childNumber;
            
            var finalName = childName;
            var counter = 1;
            while (children[finalName]) finalName = childName + '_' + counter++;
            
            var newborn = {
                人物背景: motherName + ' 的孩子',
                健康度: 80,
                水分值: 100,
                飽腹感: 100,
                疲勞度: 0,
                狀態: '新生兒',
                關係: '子女',
                母親: motherName,
                父親: get(vars, motherPath + '.生理狀態.授精者') || '未知'
            };
            
            if (gender === '女') {
                newborn.性別 = '女';
                newborn.身體特徵 = { 類型: 'female', 體型: '嬰兒型' };
                newborn.性經驗 = { 性交經驗: '無', 口交經驗: '無', 肛交經驗: '無', 性行為次數: 0, 性伴侶數量: 0, 處女: '是' };
                newborn.生理狀態 = { 陰蒂狀態: '正常', 子宮狀態: '正常', 月經週期: 1, 懷孕狀態: '未懷孕', 懷孕天數: 0 };
            } else {
                newborn.性別 = '男';
                newborn.身體特徵 = { 類型: 'male' };
                newborn.性經驗 = { 性交經驗: '無', 口交經驗: '無', 肛交經驗: '無', 性行為次數: 0, 性伴侶數量: 0, 處男: '是' };
                newborn.生理狀態 = { 勃起狀態: '未勃起', 射精狀態: '未射精' };
            }
            
            set(vars, '子嗣.' + finalName, newborn);
            keyLog('👶 ' + finalName + ' (' + gender + ') 出生');
        }
        return litter;
    }

    function updatePregnancyStage(vars, characterPath) {
        var prefix = characterPath ? characterPath + '.' : '';
        var pregnant = get(vars, prefix + '生理狀態.懷孕狀態');
        if (!pregnant || pregnant === '未懷孕' || pregnant === '' || pregnant === '流產') {
            return false;
        }
        
        var pregnancyDay = get(vars, prefix + '生理狀態.懷孕日');
        var currentDay = get(vars, '系統.經過天數') || 0;
        var days = pregnancyDay !== undefined ? Math.max(0, currentDay - pregnancyDay) : (get(vars, prefix + '生理狀態.懷孕天數') || 0);
        set(vars, prefix + '生理狀態.懷孕天數', days);
        
        var newStage = null;
        if (days <= 30) newStage = '懷孕初期';
        else if (days <= 60) newStage = '懷孕中期';
        else newStage = '懷孕後期';
        
        if (days > 90) {
            var name = characterPath ? characterPath.split('.').pop() : '主角';
            var motherPath = characterPath || '主角';
            keyLog('🤰 ' + name + ' 自動分娩！');
            generateNewborn(vars, name, motherPath);
            set(vars, prefix + '生理狀態.懷孕狀態', '未懷孕');
            set(vars, prefix + '生理狀態.懷孕天數', 0);
            set(vars, prefix + '生理狀態.懷孕日', 0);
            set(vars, prefix + '生理狀態.月經週期', 1);
            return true;
        }
        
        if (newStage && newStage !== pregnant) {
            set(vars, prefix + '生理狀態.懷孕狀態', newStage);
            keyLog('🤰 懷孕階段: ' + newStage + ' (第' + days + '天)');
            return true;
        }
        return false;
    }

    // ========== 狀態效果（包含排泄慾） ==========
    function processStatusEffects(vars) {
        var cur = getCurrentTime(vars);
        if (!cur) return;
        
        var water = int(get(vars, '生理.水分')) || 0;
        var stress = int(get(vars, '精神.壓力')) || 0;
        var lust = int(get(vars, '精神.性慾')) || 0;
        var boring = int(get(vars, '精神.無聊')) || 0;
        var sleep = int(get(vars, '精神.睡眠')) || 0;
        var full = int(get(vars, '生理.飽腹感')) || 0;
        var fatigue = int(get(vars, '狀態.疲勞')) || 0;
        
        var effects = {};
        var statuses = {};
        
        function add(k, name, desc) {
            effects[k] = { 狀態: name, 效果: desc };
            statuses[k] = { name: name };
        }
        
        // 水分（排泄慾關聯）
        if (water > 90) add('水分', '水分充足', '身體水分充足。排尿需求正常。');
        else if (water > 70) add('水分', '狀態正常', '無特殊效果。');
        else if (water > 50) add('水分', '輕微口渴', '開始想喝水，排尿頻率降低。');
        else if (water > 30) add('水分', '明顯口渴', '口乾舌燥，排尿量明顯減少。');
        else if (water > 10) add('水分', '輕度脫水', '尿液顏色深黃，排尿困難。');
        else add('水分', '嚴重脫水', '幾乎無尿，需要立即補水。');
        
        // 飽腹感（排泄慾關聯）
        if (full > 95) add('飽腹感', '過飽', '腹脹，有便意。');
        else if (full > 85) add('飽腹感', '飽足', '正常消化狀態。');
        else if (full > 60) add('飽腹感', '狀態正常', '無特殊效果。');
        else if (full > 30) add('飽腹感', '輕微飢餓', '腸胃蠕動正常。');
        else if (full > 10) add('飽腹感', '明顯飢餓', '空腹感，排便減少。');
        else add('飽腹感', '極度飢餓', '腸胃空虛，無排便。');
        
        // 壓力（影響排泄）
        if (stress < 10) add('壓力', '心神沉靜', '身心放鬆，排泄正常。');
        else if (stress < 50) add('壓力', '狀態正常', '無特殊效果。');
        else if (stress < 80) add('壓力', '高度焦慮', '緊張導致頻尿或便祕。');
        else add('壓力', '不堪重負', '壓力過大，排泄失調。');
        
        // 性慾（與排泄無直接關聯，但保留）
        if (lust < 10) add('性慾', '消退期', '性慾低下。');
        else if (lust < 25) add('性慾', '反應期', '開始有反應。');
        else if (lust < 45) add('性慾', '持續期', '性慾上升。');
        else if (lust < 65) add('性慾', '興奮期', '強烈渴望。');
        else if (lust < 85) add('性慾', '高潮期', '高度興奮。');
        else add('性慾', '失控期', '性慾失控。');
        
        // 睡眠（影響代謝與排泄）
        if (sleep > 90) add('睡眠', '精力充沛', '代謝正常，排泄規律。');
        else if (sleep > 60) add('睡眠', '狀態正常', '無特殊效果。');
        else if (sleep > 30) add('睡眠', '疲倦', '代謝減緩，排泄減少。');
        else add('睡眠', '非常疲憊', '身體機能下降，排泄異常。');
        
        // 寫入效果
        var curEff = get(vars, '狀態.生效效果') || {};
        for (var k in effects) {
            var newEff = effects[k];
            var old = curEff[k];
            if (!old || old.狀態 !== newEff.狀態 || old.效果 !== newEff.效果) {
                set(vars, '狀態.生效效果.' + k, newEff);
            }
        }
        for (var k in curEff) {
            if (k.startsWith('$')) continue;
            if (!effects[k] && curEff[k] !== undefined) {
                set(vars, '狀態.生效效果.' + k, null);
            }
        }
    }

    // ========== 時間消耗（影響排泄需求） ==========
    function processTimeConsumption(vars) {
        if (!lastSnapshot) return;
        var prevTime = lastSnapshot.time;
        var curTime = get(vars, '系統.當前時間');
        if (!prevTime || !curTime) return;
        
        var hoursDiff = 0;
        var h1 = parseInt(prevTime.split(':')[0]), m1 = parseInt(prevTime.split(':')[1]);
        var h2 = parseInt(curTime.split(':')[0]), m2 = parseInt(curTime.split(':')[1]);
        hoursDiff = (h2 * 60 + m2) - (h1 * 60 + m1);
        if (hoursDiff < 0) hoursDiff += 1440;
        hoursDiff = hoursDiff / 60;
        if (hoursDiff <= 0 || hoursDiff > 24) return;
        
        var isSleeping = get(vars, '狀態.入睡') === true;
        var sleepMultiplier = isSleeping ? 0.5 : 1.0;
        
        // 水分消耗（影響排尿需求）
        var water = get(vars, '生理.水分') || 0;
        set(vars, '生理.水分', Math.max(0, water - 1.5 * hoursDiff * sleepMultiplier));
        
        // 飽腹感消耗（影響排便需求）
        var full = get(vars, '生理.飽腹感') || 0;
        set(vars, '生理.飽腹感', Math.max(0, full - 4 * hoursDiff * sleepMultiplier));
        
        // 睡眠消耗
        var sleep = get(vars, '精神.睡眠') || 0;
        if (isSleeping) {
            set(vars, '精神.睡眠', Math.min(100, sleep + 8 * hoursDiff));
        } else {
            set(vars, '精神.睡眠', Math.max(0, sleep - 2 * hoursDiff));
        }
        
        // 疲勞消耗
        var end = int(get(vars, '屬性.耐力.等級')) || 20;
        var fatigueMax = 4 * end;
        var fatigue = get(vars, '狀態.疲勞') || 0;
        if (isSleeping) {
            set(vars, '狀態.疲勞', Math.max(0, fatigue - 4 * hoursDiff));
        } else {
            set(vars, '狀態.疲勞', Math.min(fatigueMax, fatigue + 2 * hoursDiff));
        }
    }

    // ========== 同伴狀態效果（包含排泄慾） ==========
    function processCompanionStatusEffects(vars) {
        var comps = get(vars, '同伴');
        if (!_.isPlainObject(comps)) return;
        
        var cur = getCurrentTime(vars);
        if (!cur) return;
        
        for (var n in comps) {
            if (n.startsWith('$')) continue;
            var base = '同伴.' + n;
            
            var water = int(get(vars, base + '.生理.水分')) || 0;
            var full = int(get(vars, base + '.生理.飽腹感')) || 0;
            var stress = int(get(vars, base + '.精神.壓力')) || 0;
            var sleepVal = int(get(vars, base + '.精神.睡眠')) || 0;
            var fatigue = int(get(vars, base + '.狀態.疲勞')) || 0;
            
            var effects = {};
            var statuses = {};
            
            function add(k, name, desc) {
                effects[k] = { 狀態: name, 效果: desc };
                statuses[k] = { name: name };
            }
            
            // 同伴的水分（排尿需求）
            if (water > 90) add('水分', '水分充足', '排尿正常。');
            else if (water > 70) add('水分', '狀態正常', '無特殊效果。');
            else if (water > 50) add('水分', '輕微口渴', '開始想喝水。');
            else if (water > 30) add('水分', '明顯口渴', '排尿減少。');
            else if (water > 10) add('水分', '輕度脫水', '排尿困難。');
            else add('水分', '嚴重脫水', '幾乎無尿。');
            
            // 同伴的飽腹感（排便需求）
            if (full > 95) add('飽腹感', '過飽', '有便意。');
            else if (full > 85) add('飽腹感', '飽足', '消化正常。');
            else if (full > 60) add('飽腹感', '狀態正常', '無特殊效果。');
            else if (full > 30) add('飽腹感', '輕微飢餓', '腸胃正常。');
            else if (full > 10) add('飽腹感', '明顯飢餓', '排便減少。');
            else add('飽腹感', '極度飢餓', '無排便。');
            
            // 同伴的壓力（影響排泄）
            if (stress < 10) add('壓力', '心神沉靜', '排泄正常。');
            else if (stress < 50) add('壓力', '狀態正常', '無特殊效果。');
            else if (stress < 80) add('壓力', '高度焦慮', '緊張導致排泄異常。');
            else add('壓力', '不堪重負', '排泄失調。');
            
            // 寫入效果
            var curEff = get(vars, base + '.狀態.生效效果') || {};
            for (var k in effects) {
                var newEff = effects[k];
                var old = curEff[k];
                if (!old || old.狀態 !== newEff.狀態 || old.效果 !== newEff.效果) {
                    set(vars, base + '.狀態.生效效果.' + k, newEff);
                }
            }
            for (var k in curEff) {
                if (k.startsWith('$')) continue;
                if (!effects[k] && curEff[k] !== undefined) {
                    set(vars, base + '.狀態.生效效果.' + k, null);
                }
            }
        }
    }

    // ========== 主修正函數 ==========
    function applyCorrections(vars, oldVars) {
        fixCount = 0;
        delCount = 0;
        debugLog('修正開始');

        try {
            // 處理性愛結果
            var sexResults = ensureSexResultArray(vars);
            if (sexResults.length > 0) {
                var remaining = [];
                var INITIAL_COUNTDOWN = 2;
                
                for (var i = 0; i < sexResults.length; i++) {
                    var result = sexResults[i];
                    
                    if (result.刪除倒數 === undefined || result.刪除倒數 === null) {
                        var name = result.角色;
                        if (name) {
                            var base = '同伴.' + name;
                            var affection = v(get(vars, base + '.技能.好感(對王彬).等級'), 1);
                            var forced = v(get(vars, base + '.淪陷.強制次數'), 0);
                            var special = get(vars, base + '.淪陷.特殊狀態') || '';
                            
                            var statusEffects = [];
                            var compEff = get(vars, base + '.狀態.生效效果');
                            if (_.isPlainObject(compEff)) {
                                for (var k in compEff) {
                                    if (k.startsWith('$')) continue;
                                    if (compEff[k] && compEff[k].狀態) {
                                        statusEffects.push(compEff[k].狀態);
                                    }
                                }
                            }
                            
                            var isSudden = (result.有預警 === false);
                            var hasTrauma = (special.indexOf('關係動搖') !== -1 || special.indexOf('嚴重創傷') !== -1);
                            
                            var voluntary = calculateVoluntary(affection, result.情境 || '情感推進', statusEffects, isSudden, hasTrauma, special);
                            var grade = getResultGrade(voluntary);
                            var newCorruption = getCorruptionStage(forced, affection);
                            var change = calculateAffectionChange(voluntary, affection, result.情境 || '情感推進', special, result.完成 !== false);
                            
                            var updatedResult = {
                                角色: result.角色,
                                完成: result.完成,
                                內射: result.內射,
                                避孕措施: result.避孕措施 || '無',
                                情境: result.情境 || '情感推進',
                                自願度: voluntary,
                                自願分級: grade.grade,
                                描寫建議: grade.description,
                                淪陷階段: { 階段: newCorruption.stage, 名稱: newCorruption.name },
                                關係變化: { 經驗變化: change.expChange, 等級變化: change.levelChange },
                                特殊狀態: change.newSpecialStatus || '無',
                                刪除倒數: INITIAL_COUNTDOWN,
                                授精者: result.授精者 || '阿彬'
                            };
                            
                            sexResults[i] = updatedResult;
                            result = updatedResult;
                            
                            if (result.完成 === true && result.內射 === true) {
                                calculatePregnancy(vars, name, true, result.避孕措施);
                            }
                            
                            if (change && (change.expChange !== 0 || change.levelChange !== 0)) {
                                var currentExp = get(vars, base + '.技能.好感(對王彬).當前經驗') || 0;
                                var currentLevel = get(vars, base + '.技能.好感(對王彬).等級') || 1;
                                var newExp = Math.max(0, currentExp + change.expChange);
                                var newLevel = Math.max(1, currentLevel + change.levelChange);
                                if (newExp !== currentExp) set(vars, base + '.技能.好感(對王彬).當前經驗', newExp);
                                if (newLevel !== currentLevel) set(vars, base + '.技能.好感(對王彬).等級', newLevel);
                            }
                            
                            if (newCorruption.stage !== undefined) {
                                var currentStage = get(vars, base + '.淪陷.當前階段') || 0;
                                if (newCorruption.stage !== currentStage) {
                                    set(vars, base + '.淪陷.當前階段', newCorruption.stage);
                                }
                            }
                            
                            if (change.newSpecialStatus && change.newSpecialStatus !== special) {
                                set(vars, base + '.淪陷.特殊狀態', change.newSpecialStatus);
                            }
                        }
                        remaining.push(result);
                        continue;
                    }
                    
                    result.刪除倒數--;
                    if (result.刪除倒數 > 0) {
                        remaining.push(result);
                    }
                }
                
                set(vars, '系統.性愛結果', remaining);
            }
            
            // 更新懷孕階段
            updatePregnancyStage(vars, '');
            var companions = get(vars, '同伴');
            if (_.isPlainObject(companions)) {
                for (var name in companions) {
                    if (name.startsWith('$')) continue;
                    updatePregnancyStage(vars, '同伴.' + name);
                }
            }
            
            // 時間消耗（影響排泄需求）
            processTimeConsumption(vars);
            
            // 狀態效果（包含排泄慾）
            processStatusEffects(vars);
            processCompanionStatusEffects(vars);
            
            // 更新前次時間
            var currentTime = get(vars, '系統.當前時間');
            var currentDay = get(vars, '系統.經過天數');
            if (currentTime) set(vars, '系統.前次時間', currentTime);
            if (currentDay !== undefined) set(vars, '系統.前次天數', currentDay);
            
        } catch(e) {
            errorLog('修正錯誤:', e.message);
            if (DEBUG_MODE) console.error(e.stack);
        }
    }

    // ========== 事件掛載 ==========
    eventOn(Mvu.events.VARIABLE_UPDATE_STARTED, function(vars) {
        var d = vars.stat_data;
        lastSnapshot = {
            day: get(d, '系統.經過天數'),
            time: get(d, '系統.當前時間'),
            hpMax: get(d, '生理.生命值上限'),
            hpCur: get(d, '生理.當前生命值')
        };
        fixCount = 0;
        delCount = 0;
        lastLogHash = '';
    });

    eventOn(Mvu.events.VARIABLE_UPDATE_ENDED, function(newVars, oldVars) {
        if (isProcessing) return;
        isProcessing = true;
        try {
            applyCorrections(newVars.stat_data, oldVars.stat_data);
        } catch(e) {
            errorLog('處理錯誤:', e);
            if (DEBUG_MODE) console.error(e.stack);
        } finally {
            isProcessing = false;
        }
    });

    // ========== 對外接口 ==========
    window.processSexualInteraction = function(vars, data) {
        // 外部調用性愛事件
        var name = data.characterName;
        var base = '同伴.' + name;
        var affection = v(get(vars, base + '.技能.好感(對王彬).等級'), 1);
        var forced = v(get(vars, base + '.淪陷.強制次數'), 0);
        var special = get(vars, base + '.淪陷.特殊狀態') || '';
        
        var statusEffects = [];
        var compEff = get(vars, base + '.狀態.生效效果');
        if (_.isPlainObject(compEff)) {
            for (var k in compEff) {
                if (k.startsWith('$')) continue;
                if (compEff[k] && compEff[k].狀態) statusEffects.push(compEff[k].狀態);
            }
        }
        
        var voluntary = calculateVoluntary(
            affection,
            data.interactionType || '情感推進',
            statusEffects,
            data.isSudden || false,
            special.indexOf('關係動搖') !== -1 || special.indexOf('嚴重創傷') !== -1,
            special
        );
        
        var grade = getResultGrade(voluntary);
        var forcedInc = false;
        if (data.interactionType === '強制欺騙' && voluntary < 30 && special !== '徹底沉淪') {
            forced++;
            forcedInc = true;
        }
        
        var newCorruption = getCorruptionStage(forced, affection);
        var change = calculateAffectionChange(voluntary, affection, data.interactionType || '情感推進', special, data.isSuccess !== false);
        
        if (change && (change.expChange !== 0 || change.levelChange !== 0)) {
            var currentExp = get(vars, base + '.技能.好感(對王彬).當前經驗') || 0;
            var currentLevel = get(vars, base + '.技能.好感(對王彬).等級') || 1;
            var newExp = Math.max(0, currentExp + change.expChange);
            var newLevel = Math.max(1, currentLevel + change.levelChange);
            if (newExp !== currentExp) set(vars, base + '.技能.好感(對王彬).當前經驗', newExp);
            if (newLevel !== currentLevel) set(vars, base + '.技能.好感(對王彬).等級', newLevel);
        }
        
        if (forcedInc) set(vars, base + '.淪陷.強制次數', forced);
        if (newCorruption.stage !== undefined) {
            var currentStage = get(vars, base + '.淪陷.當前階段') || 0;
            if (newCorruption.stage !== currentStage) set(vars, base + '.淪陷.當前階段', newCorruption.stage);
        }
        if (change.newSpecialStatus && change.newSpecialStatus !== special) {
            set(vars, base + '.淪陷.特殊狀態', change.newSpecialStatus);
        }
        
        var result = {
            角色: name,
            完成: data.isSuccess !== false,
            內射: data.isInternalEjaculation === true,
            避孕措施: data.避孕措施 || '無',
            情境: data.interactionType || '情感推進',
            自願度: voluntary,
            自願分級: grade.grade,
            淪陷階段: { 階段: newCorruption.stage, 名稱: newCorruption.name },
            關係變化: { 經驗變化: change.expChange, 等級變化: change.levelChange },
            特殊狀態: change.newSpecialStatus || '無',
            描寫建議: grade.description
        };
        
        var results = ensureSexResultArray(vars);
        results.push(result);
        set(vars, '系統.性愛結果', results);
        keyLog('💕 性愛事件已記錄 (' + results.length + ' 筆)');
        
        return result;
    };

    window.calculatePregnancy = calculatePregnancy;
    window.getResultGrade = getResultGrade;
    window.calculateVoluntary = calculateVoluntary;
    
    window._mvuFinalStableV08152 = true;
    console.log('✅ 性愛與生理系統已載入 (精簡版)');
})();