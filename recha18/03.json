                '同伴.' + name + '.生理.當前生命值',
                '同伴.' + name + '.精神.當前精神值'
            ];
            compPaths.forEach(function(p) {
                var val = get(vars, p);
                if (typeof val === 'number' && Number.isFinite(val)) {
                    var newVal = Math.round(val);
                    if (newVal !== val) {
                        set(vars, p, newVal);
                        logChange('同伴整數化', p + ': ' + val + ' → ' + newVal);
                        changed = true;
                    }
                }
            });
        }
    }
    
    // 🔴 強制修正主角脂肪（新增）
    var finalFat = get(vars, '生理.脂肪');
