    else if (water > 70) add('水分', '狀態正常', '沒什麼特別的感覺。');
    else if (water > 50) add('水分', '輕微口渴', '喉嚨有點幹，下意識想找水喝，注意力有點不集中。');
    else if (water > 30) add('水分', '明顯口渴', '口乾舌燥，感覺有些煩躁，身體在強烈要求補水。');
    else if (water > 10) add('水分', '輕度脫水', '嘴脣乾裂，頭暈乏力，身體因缺水而變得遲鈍。');
    else if (water > 0) add('水分', '嚴重脫水', '嚴重缺水，視野開始模糊，身體機能受到明顯影響，必須立刻補充水分。');
    else add('水分', '瀕死：脫水', '身體因嚴重缺水而瀕臨崩潰。');
    
    // ========== 8. 飽腹感 ==========
    if (full > 95) add('飽腹感', '過飽', '吃撐了，行動有點不方便。');
    else if (full > 85) add('飽腹感', '飽足', '吃飽喝足，感覺充滿能量，體力充沛，疲勞感不易累積。');
    else if (full > 60) add('飽腹感', '狀態正常', '沒什麼特別的感覺。');
    else if (full > 30) add('飽腹感', '輕微飢餓', '肚子有點空，開始期待下一頓飯。');
    else if (full > 10) add('飽腹感', '明顯飢餓', '肚子在咕咕叫，有點想吃東西了，注意力難以集中。');
    else if (full > 0) add('飽腹感', '極度飢餓', '餓得前胸貼後背，身體因爲缺乏能量而感到虛弱，必須儘快進食。');
    else add('飽腹感', '虛脫', '身體因能量儲備完全耗盡而極度虛弱，各項機能開始下降，身體正在消耗自身以維持生命。必須立即進食以阻止進一步惡化。');
    
