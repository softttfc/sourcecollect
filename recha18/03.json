    var currentDay = get(vars, '系統.經過天數') || 0;

    // 如果 currentDay 與日期不符，自動校正
    var expectedDay = currentDayOfYear;
    if (currentDay > 0 && currentDay < 365 && currentDay !== expectedDay) {
        keyLog('⚠️ 天數與日期不符: 天數=' + currentDay + ', 日期=' + currentDate + ' (應為第' + expectedDay + '天)');
        keyLog('🔧 自動校正: ' + currentDay + ' → ' + expectedDay);
        set(vars, '系統.經過天數', expectedDay);
        set(vars, '系統.前次日期', currentDate);
        return true;
    }

    var newDay = currentDayOfYear;
    
    // 如果有前次日期，計算經過的天數
    if (previousDate && typeof previousDate === 'string') {
        var parsedPrevious = parseDateString(previousDate);
        if (parsedPrevious) {
            var previousDayOfYear = dateToDayOfYear(parsedPrevious.month, parsedPrevious.day);
            var diff = currentDayOfYear - previousDayOfYear;
            
            // 跨年處理
            if (diff < 0) {
                var yearDays = 0;
                for (var m = 1; m <= 12; m++) {
                    yearDays += DAYS_IN_MONTH[m] || 30;
                }
                diff = yearDays - previousDayOfYear + currentDayOfYear;
            }
            
            // 如果有時間跨日，diff 可能為 0，但時間有跨日
            var prevTime = get(vars, '系統.前次時間');
            var curTime = get(vars, '系統.當前時間');
            if (prevTime && curTime) {
                var prevMins = parseTime(prevTime);
                var curMins = parseTime(curTime);
                if (prevMins !== null && curMins !== null && curMins < prevMins) {
                    diff += 1; // 時間跨日，加1天
                }
            }
            
            if (diff > 0) {
                // 有經過天數，更新
                newDay = currentDay + diff;
                keyLog('📅 日期更新: ' + previousDate + ' → ' + currentDate + '，經過 ' + diff + ' 天');
                set(vars, '系統.經過天數', newDay);
                set(vars, '系統.前次日期', currentDate);
