        affectionDesc = '會主動靠近對方，享受獨處時光，可以接受愛撫和深吻，但對插入式性行為仍有抗拒。'; 
    } else if (affection == 3) { 
        affectionStage = '好友'; 
        affectionDesc = '會主動開啟話題，回應熱情，願意分享想法，可以接受親吻、牽手、擁抱等肢體接觸。'; 
    } else if (affection == 2) { 
        affectionStage = '認識'; 
        affectionDesc = '願意回應對方，保持基本禮貌距離，不主動展開話題，但對方提問時會回答。'; 
    } else { 
