// ==================== 日期解析與季節計算（基於月/日格式） ====================

// 將 "5月29日" 格式轉換為 { month: 5, day: 29 }
function parseDateString(dateStr) {
    if (!dateStr || typeof dateStr !== 'string') return null;
    var match = dateStr.match(/^(\d{1,2})月(\d{1,2})日$/);
    if (!match) return null;
    return {
        month: parseInt(match[1]),
        day: parseInt(match[2])
    };
}

// 每個月的天數（不考慮閏年）
var DAYS_IN_MONTH = {
    1: 31, 2: 28, 3: 31, 4: 30, 5: 31, 6: 30,
    7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31
};

// 將 "X月X日" 轉換為「從1月1日開始的第幾天」（1月1日 = 1）
function dateToDayOfYear(month, day) {
    var total = 0;
    for (var m = 1; m < month; m++) {
        total += DAYS_IN_MONTH[m] || 30;
    }
    return total + day;
}

// 從日期字串計算「從1月1日開始的第幾天」
function getDayOfYearFromDateString(dateStr) {
    var parsed = parseDateString(dateStr);
    if (!parsed) return null;
    return dateToDayOfYear(parsed.month, parsed.day);
}

// 計算兩個日期之間的天數差（忽略年份）
function getDaysBetweenDates(dateStr1, dateStr2) {
    var d1 = parseDateString(dateStr1);
    var d2 = parseDateString(dateStr2);
    if (!d1 || !d2) return null;
    
    var day1 = dateToDayOfYear(d1.month, d1.day);
    var day2 = dateToDayOfYear(d2.month, d2.day);
    
    // 如果 date2 在 date1 之前（跨年），加上一年的天數
    if (day2 < day1) {
        var yearDays = 0;
        for (var m = 1; m <= 12; m++) {
            yearDays += DAYS_IN_MONTH[m] || 30;
        }
        return (yearDays - day1) + day2;
    }
    
    return day2 - day1;
}

// 根據月份和日期計算季節
function calculateSeasonFromDate(month, day) {
    if ((month === 3) || (month === 4) || (month === 5)) return '春季';
    if ((month === 6) || (month === 7) || (month === 8)) return '夏季';
    if ((month === 9) || (month === 10) || (month === 11)) return '秋季';
    if ((month === 12) || (month === 1) || (month === 2)) return '冬季';
    return '春季';
}

// 從日期字串計算季節
function calculateSeasonFromDateString(dateStr) {
    var parsed = parseDateString(dateStr);
    if (!parsed) return '春季';
    return calculateSeasonFromDate(parsed.month, parsed.day);
}

// 季節性事件（可選）
function getSeasonalEvent(month, day) {
    var events = {
        '櫻花季': function(m, d) {
            if (m === 3 && d >= 20) return true;
            if (m === 4 && d <= 10) return true;
            return false;
        },
        '花火季': function(m, d) {
            if (m === 7 || m === 8) return true;
            return false;
        },
        '紅葉季': function(m, d) {
            if (m === 11) return true;
            return false;
        },
        '聖誕季': function(m, d) {
            if (m === 12 && d >= 20) return true;
            return false;
        }
    };
    
    for (var name in events) {
        if (events[name](month, day)) return name;
    }
    return null;
}

function getSeasonalEventFromDateString(dateStr) {
    var parsed = parseDateString(dateStr);
    if (!parsed) return null;
    return getSeasonalEvent(parsed.month, parsed.day);
}

function calculateSeasonByDay(currentDay) {
    var total = SEASON_CONFIG.SPRING_DAYS + SEASON_CONFIG.SUMMER_DAYS + 
                SEASON_CONFIG.AUTUMN_DAYS + SEASON_CONFIG.WINTER_DAYS;
    var pos = currentDay % total;
    var acc = 0;
    
    acc += SEASON_CONFIG.SPRING_DAYS;
    if (pos < acc) return '春季';
    acc += SEASON_CONFIG.SUMMER_DAYS;
    if (pos < acc) return '夏季';
    acc += SEASON_CONFIG.AUTUMN_DAYS;
    if (pos < acc) return '秋季';
    return '冬季';
}

