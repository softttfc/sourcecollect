    // 同時也強制修正其他常見有小數的欄位
    var finalNitrogen = get(vars, '生理.氮平衡');
    if (typeof finalNitrogen === 'number' && !Number.isInteger(finalNitrogen)) {
        set(vars, '生理.氮平衡', Math.round(finalNitrogen));
        keyLog('🔧 強制修正生理.氮平衡: ' + finalNitrogen + ' → ' + Math.round(finalNitrogen));
        changed = true;
    }
    
    var finalVitamin = get(vars, '生理.維生素');
    if (typeof finalVitamin === 'number' && !Number.isInteger(finalVitamin)) {
        set(vars, '生理.維生素', Math.round(finalVitamin));
        keyLog('🔧 強制修正生理.維生素: ' + finalVitamin + ' → ' + Math.round(finalVitamin));
        changed = true;
    }
      
    var finalFullness = get(vars, '生理.飽腹感');
    if (typeof finalFullness === 'number' && !Number.isInteger(finalFullness)) {
        set(vars, '生理.飽腹感', Math.round(finalFullness));
        keyLog('🔧 強制修正生理.飽腹感: ' + finalFullness + ' → ' + Math.round(finalFullness));
        changed = true;
    }
    
    var finalSleep = get(vars, '精神.睡眠');
    if (typeof finalSleep === 'number' && !Number.isInteger(finalSleep)) {
        set(vars, '精神.睡眠', Math.round(finalSleep));
        keyLog('🔧 強制修正精神.睡眠: ' + finalSleep + ' → ' + Math.round(finalSleep));
