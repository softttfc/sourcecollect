    else if (fatPerc <= 50) add('疲勞', '微微出汗', '身體開始發熱，呼吸稍微加快，但還遠未到累的時候。');
    else if (fatPerc <= 70) add('疲勞', '有些疲憊', '肌肉微微發酸，呼吸比平時稍重，是時候考慮歇一歇了。');
