    else add('疲勞', '筋疲力盡', '身體非常沉重，每一下動作都變得吃力，只想找個地方坐下來喘口氣。');
    
    // ========== 10. 壓力 ==========
    if (stress < 10) add('壓力', '心神沉靜', '思維清晰，內心平靜。');
    else if (stress < 50) add('壓力', '狀態正常', '無特殊效果。');
    else if (stress < 80) add('壓力', '高度焦慮', '壓力極大，內心充滿焦慮和不安。');
    else if (stress < 100) add('壓力', '不堪重負', '巨大的壓力使她瀕臨崩潰邊緣。');
    else add('壓力', '精神崩潰', '精神防線徹底崩潰，陷入恐慌、偏執或絕望狀態。');
    
    // ========== 11. 睡眠 ==========
    if (sleepVal > 90) add('睡眠', '精力充沛', '充足的睡眠讓她恢復了所有精力。疲勞恢復速度加倍。');
