        } else {
            cyclePhase = '狀態正常';
            phaseDesc = '無特殊效果。';
        }
    }
    
    // ✅ 現在可以安全使用 add 函數
    if (cyclePhase !== '狀態正常') {
        add('生理週期', cyclePhase, phaseDesc);
    }
    
    // 如果懷孕，添加懷孕效果
